# ── Moodius community & revenue agent ─────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env. Anything left empty runs in MOCK mode:
#   no IG_ACCESS_TOKEN  → Instagram calls use mock data, nothing is posted
#   no ANTHROPIC_API_KEY → offline heuristic classifier + template drafts
#   no RESEND_API_KEY   → emails are written to the database log only

# Core
APP_BASE_URL=https://agent.example.com          # where this app is served (or the main site if proxied)
PUBLIC_SITE_URL=https://example.com             # main website (storefront thread); /r/ links resolve against it
AGENT_HOST=agent.example.com                    # Caddy hostname
APP_TIMEZONE=Europe/Madrid
DATABASE_URL=postgres://moodius:CHANGE_ME@localhost:5432/moodius   # docker compose sets this itself
POSTGRES_PASSWORD=                              # openssl rand -hex 24
SESSION_SECRET=                                 # openssl rand -hex 32
ADMIN_PASSWORD=                                 # 12+ characters, used at /admin/login
ENCRYPTION_KEY=                                 # openssl rand -base64 32 (encrypts the refreshed IG token at rest)
CRON_SECRET=                                    # openssl rand -hex 24 (n8n / worker → /api/cron/*)
LOG_LEVEL=info

# Instagram API with Instagram Login (see docs/03-meta-setup.md)
META_APP_SECRET=                                # Instagram app secret (verifies X-Hub-Signature-256)
META_VERIFY_TOKEN=                              # any random string; paste the same into the webhook settings
IG_ACCESS_TOKEN=                                # long-lived token (60 days; refreshed weekly by the agent)
IG_USER_ID=                                     # the professional account's Instagram user id
IG_USERNAME=moodiusaurelius
IG_API_HOST=graph.instagram.com                 # graph.facebook.com if you use Facebook Login instead
IG_API_VERSION=v25.0
IG_POLL_MEDIA=10                                # recent posts checked by the polling fallback

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low                               # low keeps Opus 5.5 at about 2 US cents per comment (docs/04)

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Moodius Agent <agent@mail.example.com>   # a domain you verified in Resend
OWNER_EMAIL=                                    # where alerts, digests and reports go
NOTIFY_POLICY=substantive                       # substantive | important  (which comments email immediately)
NOTIFY_MAX_PER_HOUR=12                          # overload control: the rest wait for the digest
NOTIFY_MIN_PRIORITY=40

# Reply modes: draft_only (default) | assisted | controlled
AGENT_MODE=draft_only
ASSISTED_CATEGORIES=appreciation
CONTROLLED_CATEGORIES=appreciation,answer_to_prompt,light_struggle
AUTO_REPLY_MAX_PER_HOUR=4
AUTO_REPLY_MAX_PER_DAY=25
AUTO_MIN_CONFIDENCE=0.85
REPLY_MAX_SIMILARITY=0.55

# DM keywords (JOURNAL, READ, REFLECT, NEWSLETTER, TOOLS) – needs instagram_business_manage_messages
DM_KEYWORDS_ENABLED=false
SUBSTACK_URL=https://moodiusaurelius.substack.com
TOOLS_GUIDE_URL=
CONSENT_VERSION=2026-10-21

# Sponsorship outreach (UK GDPR / PECR). Nothing sends without your approval in /admin/sponsors.
OUTREACH_FROM=Moodius Aurelius <partners@example.com>   # owned domain with SPF, DKIM and DMARC
OUTREACH_REPLY_TO=
OUTREACH_POSTAL_ADDRESS=                        # PO box or virtual office; keeps the brand anonymous
OUTREACH_DAILY_CAP=10
OUTREACH_SENDER_NAME=Moodius Aurelius
PRICING_CPM_LOW=20                              # £ per 1,000 reach: YOUR test assumption, not market data
PRICING_CPM_HIGH=40

# Integrations with the website / store
REVENUE_WEBHOOK_SECRET=                         # shared with the storefront (INTEGRATION-CONTRACT.md)
SELLF_WEBHOOK_SECRET=                           # only if Sellf is used later
IMPORT_TOKEN=                                   # bearer token for /api/integrations/import

# n8n (docker compose)
N8N_HOST=n8n.example.com
N8N_ENCRYPTION_KEY=                             # openssl rand -hex 24
