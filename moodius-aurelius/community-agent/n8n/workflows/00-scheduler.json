  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Madrid",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "meta": {
    "note": "Calls the agent's /api/cron/* endpoints. The agent does the work; n8n only keeps time. Needs env AGENT_URL and CRON_SECRET (set in docker-compose.yml)."
  }
