# Copy to .dev.vars for local development (wrangler reads .dev.vars, never commit it).
# In production set these in Cloudflare Pages > Settings > Variables and secrets.
# Nothing here is a real credential.

SITE_URL=http://localhost:8788

# ---- Payments --------------------------------------------------------------
# mock | stripe | lemonsqueezy
PAYMENT_PROVIDER=mock
# Mock card form for local testing only. Must be false (or unset) in production.
ALLOW_MOCK_PAYMENTS=true
# Live keys are refused unless this is true. Leave false until you've done a test purchase.
LIVE_MODE=false

# Stripe (first release). Use sk_test_... until launch.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Managed Payments = Stripe is merchant of record and handles UK/EU VAT (3.5% extra fee).
# false = plain Stripe; you are the seller of record and must handle VAT yourself.
STRIPE_MANAGED_PAYMENTS=true
STRIPE_API_VERSION=2026-04-22.dahlia
# Optional: use a Dashboard price instead of inline price_data
STRIPE_PRICE_THE_UNEXAMINED_SELF=
# Optional: require ticking Stripe's Terms box (needs a Terms URL in Stripe settings)
STRIPE_TOS_CONSENT=false
# Only used when STRIPE_MANAGED_PAYMENTS=false and Stripe Tax is set up
STRIPE_AUTOMATIC_TAX=false

# Lemon Squeezy (fallback merchant of record)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_THE_UNEXAMINED_SELF=

# ---- Delivery --------------------------------------------------------------
DOWNLOAD_TTL_DAYS=30
DOWNLOAD_MAX_USES=5
PAGE_CLAIM_LIMIT=3

# ---- Email -----------------------------------------------------------------
# log = keep emails in the outbox table only; resend = really send
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Moodius Aurelius <hello@yourdomain.com>
SUPPORT_EMAIL=hello@yourdomain.com
# Required in marketing email footers (UK PECR / CAN-SPAM): use the PO box, never a home address
POSTAL_ADDRESS=

# ---- Back office -----------------------------------------------------------
# Long random string: openssl rand -hex 32
ADMIN_TOKEN=change_me_to_a_long_random_string

# ---- Community agent (one domain, revenue dashboard) -----------------------
# Leave empty until the agent is deployed; while empty the site uses its own fallback
# /r/ links and newsletter capture.
COMMUNITY_AGENT_URL=
REVENUE_WEBHOOK_SECRET=
IP_HASH_SALT=change_me_random

# ---- Links -----------------------------------------------------------------
SUBSTACK_URL=
PINTEREST_URL=
