      "position": [
        220,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "// Meta sends { object: 'instagram', entry: [{ changes: [{ field: 'comments', value }] }] }.\nconst cfg = $('Config').first().json;\nconst body = $('Meta events (POST)').first().json.body || {};\nconst kw = new RegExp('\\\\b' + cfg.KEYWORD + '\\\\b', 'i');\nconst out = [];\nfor (const entry of body.entry || []) {\n  for (const ch of entry.changes || []) {\n    if (ch.field !== 'comments' || !ch.value) continue;\n    const v = ch.value;\n    // Skip our own replies so the account never answers itself.\n    if (v.from && v.from.id === cfg.IG_USER_ID) continue;\n    out.push({ json: {\n      received_utc: new Date().toISOString().slice(0, 16),\n      username: v.from?.username || '',\n      text: v.text || '',\n      media_id: v.media?.id || '',\n      comment_id: v.id,\n      is_reply: Boolean(v.parent_id),\n      keyword_dm: kw.test(v.text || '')\n    } });\n  }\n}\nreturn out;"
      },
