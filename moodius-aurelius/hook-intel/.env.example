# Hook Intel settings. Nothing here is required for the default free setup.
# Copy to .env (setup.sh does this). Never commit .env.

# Database location (default: data/hookintel.db)
HOOKINTEL_DB=

# Python used by the bin/ wrappers (default: python3)
HOOKINTEL_PYTHON=

# OPTIONAL, free: YouTube Data API v3 key (Google Cloud console, 10,000 units/day free).
# Not used yet; would add exact like and comment counts. Leave empty unless the owner approves creating one.
YOUTUBE_API_KEY=

# NOT USED, and stays off without the owner's explicit OK: any paid AI API.
# Scripts are written in a Claude Code session (his existing plan), not through a metered API key.
ANTHROPIC_API_KEY=
